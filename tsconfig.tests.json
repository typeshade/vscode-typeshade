{
  // The pass over what no package's own project covers: the root's own configuration files, and
  // any script written in TypeScript. Test files are NOT here: each package checks its own
  // `src/**/*.ts`, tests included, because nothing is emitted through `tsc` any more and so
  // there is no `dist/` for a test to be kept out of.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["scripts/**/*.ts", "vitest.config.mts"]
}

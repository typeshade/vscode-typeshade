{
  // Type-checking only. The artifact is built by esbuild (`scripts/build.mjs`), not by `tsc`:
  // the compiler arrives as a vendored submodule that has to be bundled in rather than resolved
  // at run time, and tsserver loads one CommonJS file (`docs/design.md` §2, §7).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["src/**/*.ts"]
}

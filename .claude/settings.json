{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ ! -f vendor/typeshade/scripts/downstream-impact.ts ] || bun vendor/typeshade/scripts/downstream-impact.ts --hook --repo vscode-typeshade --submodule vendor/typeshade; }",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
